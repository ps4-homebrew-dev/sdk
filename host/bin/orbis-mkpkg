###############################################################################
# Crypto primitives
###############################################################################

def sha256(*parts):
    h = hashlib.sha256()
    for p in parts:
        h.update(p)
    return h.digest()


def hmac_sha256(key, data):
    return hmac.new(key, data, hashlib.sha256).digest()


def _xtime(a):
    a <<= 1
    return a ^ 0x11B if a & 0x100 else a


def _make_aes_tables():
    exp = [0] * 255
    log = [0] * 256
    x = 1
    for i in range(255):
        exp[i] = x
        log[x] = i
        x ^= _xtime(x)  # multiply by the generator 3
    sbox = [0] * 256
    for a in range(256):
        inv = exp[(255 - log[a]) % 255] if a else 0
        s = r = inv
        for _ in range(4):
            r = ((r << 1) | (r >> 7)) & 0xFF
            s ^= r
        sbox[a] = s ^ 0x63
    t0 = []
    for a in range(256):
        s = sbox[a]
        s2 = _xtime(s) & 0xFF
        t0.append((s2 << 24) | (s << 16) | (s << 8) | (s2 ^ s))
    t1 = [((w >> 8) | (w << 24)) & 0xFFFFFFFF for w in t0]
    t2 = [((w >> 16) | (w << 16)) & 0xFFFFFFFF for w in t0]
    t3 = [((w >> 24) | (w << 8)) & 0xFFFFFFFF for w in t0]
    return sbox, t0, t1, t2, t3


class PyAes128:
    '''
    A small table-driven AES-128 encryptor, used when the cryptography
    package is not installed. Only encryption is needed to build a PKG.
    '''

    _tables = None

    def __init__(self, key):
        if PyAes128._tables is None:
            PyAes128._tables = _make_aes_tables()
        sbox = self._tables[0]
        w = list(struct.unpack(">4I", key))
        rcon = 1
        for i in range(4, 44):
            t = w[i - 1]
            if i % 4 == 0:
                t = ((sbox[(t >> 16) & 0xFF] << 24) | (sbox[(t >> 8) & 0xFF] << 16)
                     | (sbox[t & 0xFF] << 8) | sbox[t >> 24]) ^ (rcon << 24)
                rcon = _xtime(rcon) & 0xFF
            w.append(w[i - 4] ^ t)
        self.rk = w

    def encrypt_block(self, block):
        sbox, t0, t1, t2, t3 = self._tables
        rk = self.rk
        s0, s1, s2, s3 = struct.unpack(">4I", block)
        s0 ^= rk[0]
        s1 ^= rk[1]
        s2 ^= rk[2]
        s3 ^= rk[3]
        for r in range(4, 40, 4):
            s0, s1, s2, s3 = (
                t0[s0 >> 24] ^ t1[(s1 >> 16) & 255] ^ t2[(s2 >> 8) & 255] ^ t3[s3 & 255] ^ rk[r],
                t0[s1 >> 24] ^ t1[(s2 >> 16) & 255] ^ t2[(s3 >> 8) & 255] ^ t3[s0 & 255] ^ rk[r + 1],
                t0[s2 >> 24] ^ t1[(s3 >> 16) & 255] ^ t2[(s0 >> 8) & 255] ^ t3[s1 & 255] ^ rk[r + 2],
                t0[s3 >> 24] ^ t1[(s0 >> 16) & 255] ^ t2[(s1 >> 8) & 255] ^ t3[s2 & 255] ^ rk[r + 3])
        return struct.pack(
            ">4I",
            ((sbox[s0 >> 24] << 24) | (sbox[(s1 >> 16) & 255] << 16)
             | (sbox[(s2 >> 8) & 255] << 8) | sbox[s3 & 255]) ^ rk[40],
            ((sbox[s1 >> 24] << 24) | (sbox[(s2 >> 16) & 255] << 16)
             | (sbox[(s3 >> 8) & 255] << 8) | sbox[s0 & 255]) ^ rk[41],
            ((sbox[s2 >> 24] << 24) | (sbox[(s3 >> 16) & 255] << 16)
             | (sbox[(s0 >> 8) & 255] << 8) | sbox[s1 & 255]) ^ rk[42],
            ((sbox[s3 >> 24] << 24) | (sbox[(s0 >> 16) & 255] << 16)
             | (sbox[(s1 >> 8) & 255] << 8) | sbox[s2 & 255]) ^ rk[43])


def aes128_cbc_encrypt(key, iv, data):
    '''AES-128-CBC without padding.'''
    if len(data) % 16:
        raise ValueError("AES-CBC input must be a multiple of 16 bytes")
    if not data:
        return b""
    if Cipher is not None:
        enc = Cipher(algorithms.AES(key), modes.CBC(iv)).encryptor()
        return enc.update(data) + enc.finalize()
    aes = PyAes128(key)
    out = bytearray()
    prev = int.from_bytes(iv, "big")
    for i in range(0, len(data), 16):
        block = aes.encrypt_block((int.from_bytes(data[i:i + 16], "big") ^ prev).to_bytes(16, "big"))
        out += block
        prev = int.from_bytes(block, "big")
    return bytes(out)


class XtsEncryptor:
    '''AES-128-XTS on 4 KiB sectors; the tweak is the little-endian sector number.'''

    def __init__(self, data_key, tweak_key):
        self.data_key = data_key
        self.tweak_key = tweak_key
        if Cipher is None:
            self.data_aes = PyAes128(data_key)
            self.tweak_aes = PyAes128(tweak_key)
        else:
            self.algo = algorithms.AES(data_key + tweak_key)

    def encrypt_sector(self, data, sector):
        if Cipher is not None:
            enc = Cipher(self.algo, modes.XTS(sector.to_bytes(16, "little"))).encryptor()
            return enc.update(data) + enc.finalize()
        mask = (1 << 128) - 1
        t = int.from_bytes(self.tweak_aes.encrypt_block(sector.to_bytes(16, "little")), "little")
        enc = self.data_aes.encrypt_block
        out = bytearray(len(data))
        for i in range(0, len(data), 16):
            p = int.from_bytes(data[i:i + 16], "little") ^ t
            c = int.from_bytes(enc(p.to_bytes(16, "little")), "little") ^ t
            out[i:i + 16] = c.to_bytes(16, "little")
            t <<= 1
            if t >> 128:
                t = (t & mask) ^ 0x87
        return bytes(out)


class MersenneTwister:
    '''MT19937 seeded with init_by_array(), as used by LibOrbisPkg.'''

    N = 624
    M = 397

    def __init__(self, key):
        n = self.N
        mt = [0] * n
        mt[0] = 19650218
        for i in range(1, n):
            mt[i] = (1812433253 * (mt[i - 1] ^ (mt[i - 1] >> 30)) + i) & 0xFFFFFFFF
        i, j = 1, 0
        for _ in range(max(n, len(key))):
            mt[i] = ((mt[i] ^ (((mt[i - 1] ^ (mt[i - 1] >> 30)) * 1664525) & 0xFFFFFFFF))
                     + key[j] + j) & 0xFFFFFFFF
            i += 1
            j += 1
            if i >= n:
                mt[0] = mt[n - 1]
                i = 1
            if j >= len(key):
                j = 0
        for _ in range(n - 1):
            mt[i] = ((mt[i] ^ (((mt[i - 1] ^ (mt[i - 1] >> 30)) * 1566083941) & 0xFFFFFFFF))
                     - i) & 0xFFFFFFFF
            i += 1
            if i >= n:
                mt[0] = mt[n - 1]
                i = 1
        mt[0] = 0x80000000
        self.mt = mt
        self.index = n

    def next_u32(self):
        mt = self.mt
        n, m = self.N, self.M
        if self.index >= n:
            for k in range(n):
                y = (mt[k] & 0x80000000) | (mt[(k + 1) % n] & 0x7FFFFFFF)
                mt[k] = mt[(k + m) % n] ^ (y >> 1) ^ (0x9908B0DF if y & 1 else 0)
            self.index = 0
        y = mt[self.index]
        self.index += 1
        y ^= y >> 11
        y ^= (y << 7) & 0x9D2C5680
        y ^= (y << 15) & 0xEFC60000
        y ^= y >> 18
        return y & 0xFFFFFFFF


def rsa2048_encrypt_key(modulus, data):
    '''
    RSA-2048 encrypt a 32-byte value with PKCS#1 v1.5 type 2 padding whose
    "random" bytes are derived deterministically from the key and the value.
    '''
    assert len(modulus) == 256 and len(data) == 32
    seed = sha256(sha256(modulus + data))
    mt = MersenneTwister(list(struct.unpack(">8I", seed)))
    padded = bytearray(256)
    padded[1] = 2
    padded[224:256] = data
    k = 2
    while k < 223:
        rnd = sha256(struct.pack(">12I", *(mt.next_u32() for _ in range(12))))
        for r in rnd:
            if k >= 223:
                break
            if r:
                padded[k] = r
                k += 1
    n = int.from_bytes(modulus, "big")
    return pow(int.from_bytes(padded, "big"), 65537, n).to_bytes(256, "big")


_SHA256_DIGEST_INFO = bytes.fromhex("3031300d060960864801650304020105000420")


def rsa2048_sign_sha256(digest, modulus, private_exponent):
    '''RSASSA-PKCS1-v1_5 signature of a SHA-256 digest.'''
    t = _SHA256_DIGEST_INFO + digest
    em = b"\x00\x01" + b"\xff" * (256 - len(t) - 3) + b"\x00" + t
    n = int.from_bytes(modulus, "big")
    d = int.from_bytes(private_exponent, "big")
    return pow(int.from_bytes(em, "big"), d, n).to_bytes(256, "big")


def compute_key(content_id, passcode, index):
    '''Derive passcode key number `index` (index 1 is the EKPFS).'''
    return sha256(sha256(struct.pack(">I", index)),
                  sha256(content_id.encode("ascii").ljust(48, b"\0")),
                  passcode.encode("ascii", "replace"))


def create_keystone(passcode):
    header = bytes.fromhex("6b657973746f6e65020001000000000000000000000000000000000000000000")
    fingerprint = hmac_sha256(KEYSTONE_HMAC_KEY, passcode.encode("ascii", "replace"))
    return header + fingerprint + hmac_sha256(KEYSTONE_MAC_DATA, header + fingerprint)


def pfs_crypto_key(ekpfs, seed, index):
    return hmac_sha256(ekpfs, struct.pack("<I", index) + seed)


###############################################################################
# .NET string semantics
###############################################################################

# The order in which .NET's culture-aware comparer (ICU root collation) puts
# printable ASCII characters. Letters compare case-insensitively first, and
# lower case wins ties.
_COLLATION_ORDER = (" _-,;:!?.'\"()[]{}@*/\\&#%`^+<=>|~$"
                    "0123456789abcdefghijklmnopqrstuvwxyz")
_PRIMARY = {c: i for i, c in enumerate(_COLLATION_ORDER)}
for _c in "abcdefghijklmnopqrstuvwxyz":
    _PRIMARY[_c.upper()] = _PRIMARY[_c]


def collation_key(s):
    '''Sort key equivalent to .NET's default string comparison for ASCII.'''
    if s is None:
        return ((), ())  # null sorts first
    primary = tuple(_PRIMARY.get(c, 0x10000 + ord(c)) for c in s)
    tertiary = tuple(1 if "A" <= c <= "Z" else 0 for c in s)
    return (primary, tertiary)


def path_hash(path):
    '''The flat_path_table hash of a path name.'''
    h = 0
    for c in path:
        h = (ord(c.upper()) + 31 * h) & 0xFFFFFFFF
    return h


def align(value, alignment):
    rem = value % alignment
    return value + alignment - rem if rem else value


def ceil_div(a, b):
    return -(-a // b)


###############################################################################
# param.sfo
###############################################################################

SFO_UTF8_SPECIAL = 0x0004
SFO_UTF8 = 0x0204
SFO_INTEGER = 0x0404


class SfoValue:
    def __init__(self, name, type, value, max_length=4):
        self.name = name
        self.type = type
        self.value = value
        self.max_length = 4 if type == SFO_INTEGER else max_length

    @property
    def length(self):
        if self.type == SFO_INTEGER:
            return 4
        if self.type == SFO_UTF8:
            return len(self.value.encode("utf-8")) + 1
        return len(self.value.encode("utf-16-le")) // 2

    def to_bytes(self):
        if self.type == SFO_INTEGER:
            return struct.pack("<i", self.value)
        if self.type == SFO_UTF8:
            return self.value.encode("utf-8") + b"\0"
        return self.value.encode("utf-8")

    def __str__(self):
        if self.type == SFO_INTEGER:
            return f"0x{self.value & 0xFFFFFFFF:08x}"
        return self.value


class ParamSfo:
    def __init__(self, values=None):
        self.values = list(values or [])

    def __getitem__(self, name):
        for v in self.values:
            if v.name == name:
                return v
        return None

    def __setitem__(self, name, value):
        self.values = [v for v in self.values if v.name != name]
        value.name = name
        self.values.append(value)

    @staticmethod
    def parse(data):
        start = 0
        if data[:4] == b"SCEC":
            start = 0x800
        if data[start:start + 4] != b"\0PSF":
            raise ValueError("File is missing SFO magic")
        key_table, data_table, count = struct.unpack_from("<iii", data, start + 8)
        sfo = ParamSfo()
        for i in range(count):
            key_off, fmt, length, max_len, data_off = struct.unpack_from(
                "<HHiiI", data, start + 0x14 + 0x10 * i)
            kpos = start + key_table + key_off
            name = data[kpos:data.index(b"\0", kpos)].decode("ascii", "replace")
            dpos = start + data_table + data_off
            if fmt == SFO_INTEGER:
                value = struct.unpack_from("<i", data, dpos)[0]
            elif fmt == SFO_UTF8:
                n = length - 1 if length > 0 else length
                value = data[dpos:dpos + n].decode("utf-8", "replace")
            elif fmt == SFO_UTF8_SPECIAL:
                value = data[dpos:dpos + length].decode("utf-8", "replace")
            else:
                raise ValueError(f"Unknown SFO type: {fmt:04X}")
            sfo.values.append(SfoValue(name, fmt, value, max_len))
        return sfo

    def _sort(self):
        self.values.sort(key=lambda v: collation_key(v.name))

    def serialize(self):
        self._sort()
        key_table = 0x14 + 0x10 * len(self.values)
        key_size = sum(len(v.name) + 1 for v in self.values)
        data_table = align(key_table + key_size, 4)
        out = bytearray(data_table + sum(v.max_length for v in self.values))
        struct.pack_into("<4siiii", out, 0, b"\0PSF", 0x101, key_table, data_table,
                         len(self.values))
        key_off = data_off = 0
        for i, v in enumerate(self.values):
            raw = v.to_bytes()
            if len(raw) > v.max_length:
                raise ValueError(f"param.sfo value {v.name} is longer than its "
                                 f"maximum length ({v.max_length})")
            struct.pack_into("<HHiii", out, 0x14 + 0x10 * i, key_off, v.type,
                             v.length, v.max_length, data_off)
            name = v.name.encode("ascii", "replace")
            out[key_table + key_off:key_table + key_off + len(name)] = name
            out[data_table + data_off:data_table + data_off + len(raw)] = raw
            key_off += len(v.name) + 1
            data_off += v.max_length
        return bytes(out)


###############################################################################
# GP4 projects
###############################################################################

class Gp4Error(Exception):
    pass


class Gp4Project:
    VOLUME_TYPES = ("bd25", "bd50", "bd50_50", "bd50_25", "bd25_50", "exfat",
                    "pfs_plain", "pfs_signed", "pfs_nested", "pkg_ps4_app",
                    "pkg_ps4_patch", "pkg_ps4_remaster", "pkg_ps4_ac_data",
                    "pkg_ps4_ac_nodata", "pkg_ps4_sf_theme", "pkg_ps4_theme")

    def __init__(self, path):
        self.path = path
        self.dir = os.path.dirname(path)
        try:
            root = ET.parse(path).getroot()
        except (ET.ParseError, OSError) as e:
            raise Gp4Error(f"Could not read {path}: {e}") from e
        if root.tag != "psproject":
            raise Gp4Error(f"{path} is not a GP4 project")

        volume = root.find("volume")
        package = volume.find("package") if volume is not None else None
        if package is None:
            raise Gp4Error(f"{path} has no <volume>/<package> element")

        def text(name):
            elem = volume.find(name)
            return elem.text.strip() if elem is not None and elem.text else None

        self.volume_type = text("volume_type")
        if self.volume_type not in self.VOLUME_TYPES:
            raise Gp4Error(f"Unknown Volume Type: {self.volume_type}")
        self.volume_ts = text("volume_ts")
        self.content_id = package.get("content_id") or ""
        self.passcode = package.get("passcode") or ""
        self.entitlement_key = package.get("entitlement_key")
        self.c_date = package.get("c_date")
        if self.entitlement_key is None and self.volume_type in ("pkg_ps4_ac_data",
                                                                 "pkg_ps4_ac_nodata"):
            self.entitlement_key = "0" * 32

        # (target path, source path) pairs, in project order
        self.files = []
        files = root.find("files")
        for f in (files.findall("file") if files is not None else []):
            targ = (f.get("targ_path") or "").replace("\\", "/").lstrip("/")
            orig = f.get("orig_path")
            if orig is None:
                orig = targ.replace("/", os.sep)
            self.files.append((targ, orig))

        # Nested directory names, in project order
        def dirs(elem):
            return [(d.get("targ_name") or "", dirs(d)) for d in elem.findall("dir")]
        rootdir = root.find("rootdir")
        self.dirs = dirs(rootdir) if rootdir is not None else []

    def source_path(self, orig):
        path = os.path.join(self.dir, orig)
        if not os.path.isfile(path) and "\\" in orig:
            alt = os.path.join(self.dir, orig.replace("\\", "/"))
            if os.path.isfile(alt):
                return alt
        return path

    def timestamp(self):
        '''The volume timestamp, in seconds since the epoch.'''
        if not self.volume_ts:
            return int(datetime.now().timestamp())
        return int(parse_datetime(self.volume_ts).timestamp())


def parse_datetime(text):
    '''Parse a GP4 date/time. Values without a time zone are local time.'''
    text = text.strip().replace("Z", "+00:00")
    try:
        return datetime.fromisoformat(text)
    except ValueError:
        pass
    for fmt in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%dT%H:%M:%S", "%Y-%m-%d", "%Y/%m/%d %H:%M:%S",
                "%Y/%m/%d"):
        try:
            return datetime.strptime(text, fmt)
        except ValueError:
            pass
    raise Gp4Error(f"Could not parse date/time '{text}'")


def validate_project(proj):
    '''Returns a list of (fatal, message) tuples, mirroring PkgTool.Core.'''
    results = []

    def fatal(msg):
        results.append((True, msg))

    def warning(msg):
        results.append((False, msg))

    if len(proj.passcode) != 32:
        fatal("Passcode must be 32 characters long.")
    missing = [orig for _, orig in proj.files if not os.path.isfile(proj.source_path(orig))]
    if missing:
        fatal("Could not find source file(s): " + ", ".join(missing))
    seen, dupes = set(), []
    for targ, _ in proj.files:
        if targ in seen and targ not in dupes:
            dupes.append(targ)
        seen.add(targ)
    if dupes:
        fatal("PKG has duplicate filename(s): " + ", ".join(dupes))
    if len(proj.content_id) != 36:
        fatal("PKG Content ID must be 36 characters long.")
    if not re.match(r"^[A-Z]{2}[0-9]{4}-[A-Z]{4}[0-9]{5}_00-[A-Z0-9]{16}$", proj.content_id):
        warning("PKG Content ID is the wrong format. "
                "Format should be XXYYYY-XXXXYYYYY_00-ZZZZZZZZZZZZZZZZ, "
                "where X is a letter, Y is a number, and Z is either.")
    if proj.volume_type not in ("pkg_ps4_app", "pkg_ps4_ac_data", "pkg_ps4_ac_nodata"):
        fatal("Unsupported PKG volume type: " + proj.volume_type)
    for targ, orig in proj.files:
        try:
            targ.encode("ascii")
        except UnicodeEncodeError:
            fatal(f"File name {targ} is not ASCII; PFS names must be ASCII.")
    for name in iter_dir_names(proj.dirs):
        try:
            name.encode("ascii")
        except UnicodeEncodeError:
            fatal(f"Directory name {name} is not ASCII; PFS names must be ASCII.")

    sfo_files = [orig for targ, orig in proj.files if targ == "sce_sys/param.sfo"]
    if not sfo_files or not os.path.isfile(proj.source_path(sfo_files[0])):
        fatal("Required file sce_sys/param.sfo is missing.")
        return results
    try:
        with open(proj.source_path(sfo_files[0]), "rb") as f:
            sfo = ParamSfo.parse(f.read())
    except (ValueError, IndexError, struct.error) as e:
        fatal(f"Could not load param.sfo file: {e}")
        return results

    cid, tid, cat = sfo["CONTENT_ID"], sfo["TITLE_ID"], sfo["CATEGORY"]
    if cid is None:
        warning("param.sfo has no CONTENT_ID.")
    elif proj.content_id != str(cid):
        warning(f"PKG Content ID {proj.content_id} does not match CONTENT_ID {cid} "
                "in param.sfo.")
    if cid is not None and tid is not None and not str(cid)[7:].startswith(str(tid)):
        warning(f"SFO TITLE_ID {tid} does not match the CONTENT_ID {cid}.")
    if cat is not None:
        cat = str(cat)
        ok = True
        if proj.volume_type == "pkg_ps4_app":
            ok = cat.startswith("g")
        elif proj.volume_type in ("pkg_ps4_ac_data", "pkg_ps4_ac_nodata",
                                  "pkg_ps4_theme", "pkg_ps4_sf_theme"):
            ok = cat == "ac"
        if not ok:
            warning(f"SFO CATEGORY {cat} is not valid for PKG volume type "
                    f"{proj.volume_type}.")
    return results


def iter_dir_names(dirs):
    for name, children in dirs:
        yield name
        yield from iter_dir_names(children)


###############################################################################
# PFS images
###############################################################################

INODE_MODE_RX = 0x16D  # r-xr-xr-x
INODE_MODE_DIR = 0x4000 | INODE_MODE_RX
INODE_MODE_FILE = 0x8000 | INODE_MODE_RX

INODE_FLAG_COMPRESSED = 0x1
INODE_FLAG_UNK2 = 0x4
INODE_FLAG_UNK3 = 0x8
INODE_FLAG_READONLY = 0x10
INODE_FLAG_INTERNAL = 0x20000

DIRENT_FILE = 2
DIRENT_DIR = 3
DIRENT_DOT = 4
DIRENT_DOTDOT = 5
DIRENT_MAX_SIZE = 280

PFS_MODE_SIGNED = 0x1
PFS_MODE_ENCRYPTED = 0x4
PFS_MODE_ALWAYS = 0x8

INODE_HEAD = struct.Struct("<HHIqq4q4I2I2QI")   # common to all inode kinds, 0x64 bytes
DINODE_D32_SIZE = 0xA8
DINODE_S32_SIZE = 0x2C8
SIG_SIZE = 36  # 32-byte HMAC followed by a 32-bit block number


class Inode:
    def __init__(self, signed, mode, blocks, size=0, size_compressed=0, nlink=1,
                 number=0, flags=0, time=0):
        self.signed = signed
        self.mode = mode
        self.blocks = blocks
        self.size = size
        self.size_compressed = size_compressed
        self.nlink = nlink
        self.number = number
        self.flags = flags
        self.time = time
        self.db = [0] * 12
        self.ib = [0] * 5

    @property
    def start_block(self):
        return self.db[0]

    def _head(self):
        t = self.time
        return INODE_HEAD.pack(self.mode, self.nlink, self.flags, self.size,
                               self.size_compressed, t, t, t, t, 0, 0, 0, 0, 0, 0, 0, 0,
                               self.blocks)

    def to_bytes(self):
        if not self.signed:
            return self._head() + struct.pack("<12i5i", *self.db, *self.ib)
        sig = bytes(32)
        return self._head() + b"".join(sig + struct.pack("<i", b) for b in self.db + self.ib)

    def to_bytes_s64(self):
        '''The 64-bit signed inode layout used for the superblock's inode-block record.'''
        sig = bytes(32)
        return (self._head() + bytes(4)
                + b"".join(sig + struct.pack("<q", b) for b in self.db + self.ib))


class Dirent:
    def __init__(self, name, ino, type):
        self.name = name
        self.ino = ino
        self.type = type

    @property
    def ent_size(self):
        return align(len(self.name) + 17, 8)

    def to_bytes(self):
        name = self.name.encode("ascii")
        return struct.pack("<Iiii", self.ino, self.type, len(name), self.ent_size) \
            + name.ljust(self.ent_size - 16, b"\0")


class FSNode:
    def __init__(self, name, parent=None):
        self.name = name
        self.parent = parent
        self.ino = None

    def full_path(self, suffix=""):
        if self.parent is None:
            return suffix
        return self.parent.full_path("/" + self.name + suffix)


class FSDir(FSNode):
    def __init__(self, name, parent=None):
        super().__init__(name, parent)
        self.dirs = []
        self.files = []
        self.dirents = []

    @property
    def size(self):
        '''Bytes used by the dirents, which never straddle a block boundary.'''
        pos = 0
        for d in self.dirents:
            pos += d.ent_size
            if pos % BLOCK_SIZE > BLOCK_SIZE - DIRENT_MAX_SIZE:
                pos = (pos // BLOCK_SIZE + 1) * BLOCK_SIZE
        return max(pos, sum(d.ent_size for d in self.dirents))

    def dirent_bytes(self):
        out = bytearray(align(self.size, BLOCK_SIZE))
        pos = 0
        for d in self.dirents:
            raw = d.to_bytes()
            out[pos:pos + len(raw)] = raw
            pos += len(raw)
            if pos % BLOCK_SIZE > BLOCK_SIZE - DIRENT_MAX_SIZE:
                pos = (pos // BLOCK_SIZE + 1) * BLOCK_SIZE
        return bytes(out[:self.size])

    def all_dirs(self):
        ret = list(self.dirs)
        for d in self.dirs:
            ret += d.all_dirs()
        return ret

    def all_files(self):
        ret = list(self.files)
        for d in self.all_dirs():
            ret += d.files
        return ret

    def get_dir(self, name):
        for d in self.dirs:
            if d.name == name:
                return d
        return None

    def get_file(self, path):
        head, _, rest = path.partition("/")
        if not rest:
            for f in self.files:
                if f.name == path:
                    return f
            return None
        d = self.get_dir(head)
        return d.get_file(rest) if d else None


class FSFile(FSNode):
    '''
    A file whose content is a host file (`path`), a byte string (`data`),
    or produced by `chunks()`, a callable returning an iterable of bytes.
    '''

    def __init__(self, name, parent=None, path=None, data=None, chunks=None, size=None,
                 compressed_size=None, compress=False):
        super().__init__(name, parent)
        self.path = path
        self.data = data
        self.chunks = chunks
        if size is None:
            size = len(data) if data is not None else os.path.getsize(path)
        self.size = size
        self.compressed_size = size if compressed_size is None else compressed_size
        self.compress = compress

    def read_chunks(self, chunk_size=1 << 20):
        if self.data is not None:
            yield self.data
            return
        if self.chunks is not None:
            yield from self.chunks()
            return
        remaining = self.size
        with open(self.path, "rb") as f:
            while remaining > 0:
                buf = f.read(min(chunk_size, remaining))
                if not buf:
                    break
                remaining -= len(buf)
                yield buf
        if remaining:
            raise IOError(f"{self.path} changed size while building the PKG")

    def read_all(self):
        return b"".join(self.read_chunks())


def is_entry_file(node, root):
    '''True if `node` is sce_sys/<name> where <name> is stored as a PKG entry.'''
    name = node.name
    parent = node.parent
    while parent is not None and parent is not root:
        if parent.parent is root and parent.name == "sce_sys":
            return name in ENTRY_NAME_TO_ID
        name = parent.name + "/" + name
        parent = parent.parent
    return False


class PfsBuilder:
    '''Lays out a PFS image (see LibOrbisPkg's PfsBuilder).'''

    def __init__(self, root, file_time, sign=False, encrypt=False, ekpfs=None,
                 seed=None, min_blocks=0):
        self.root = root
        self.file_time = file_time
        self.sign = sign
        self.encrypt = encrypt
        self.ekpfs = ekpfs
        self.seed = seed if (sign or encrypt) else None
        self.min_blocks = min_blocks
        self.mode = ((PFS_MODE_SIGNED if sign else 0) | (PFS_MODE_ENCRYPTED if encrypt else 0)
                     | PFS_MODE_ALWAYS)
        self.inode_size = DINODE_S32_SIZE if sign else DINODE_D32_SIZE
        self.empty_block = 4

        # Signatures to compute, as (block, signature offset, signed size).
        # Data block signatures are kept as runs (first block, count, first
        # signature offset) with consecutive signatures 36 bytes apart.
        self.final_sigs = [(0, 0x380, 0x5A0)]
        self.data_sig_runs = []

        self.inodes = []
        self.inode_block_sig = Inode(True, 0, 1, BLOCK_SIZE, BLOCK_SIZE, 1, 0,
                                     INODE_FLAG_READONLY, file_time)

        self.all_dirs = root.all_dirs()
        self.all_files = [f for f in root.all_files() if not is_entry_file(f, root)]
        self.all_nodes = (sorted(self.all_dirs, key=lambda d: collation_key(d.full_path()))
                          + self.all_files)
        hashes = [path_hash(n.full_path()) for n in self.all_nodes]
        self.setup_root_structure(len(set(hashes)) != len(hashes))
        self.add_dir_inodes()
        self.add_file_inodes()
        self.make_flat_path_table()
        self.all_nodes.insert(0, root)
        self.calculate_data_block_layout()

    @property
    def size(self):
        return self.ndblock * BLOCK_SIZE

    def make_inode(self, mode, blocks, size=0, size_compressed=0, nlink=1, number=0,
                   flags=0):
        if self.sign:
            flags |= INODE_FLAG_UNK2 | INODE_FLAG_UNK3
        return Inode(self.sign, mode, blocks, size, size_compressed, nlink, number, flags,
                     self.file_time)

    def setup_root_structure(self, has_collision):
        num = 0
        self.super_root_ino = self.make_inode(INODE_MODE_DIR, 1, BLOCK_SIZE, BLOCK_SIZE, 1, num,
                                              INODE_FLAG_INTERNAL | INODE_FLAG_READONLY)
        self.inodes.append(self.super_root_ino)
        num += 1
        self.fpt_ino = self.make_inode(INODE_MODE_FILE, 1, number=num,
                                       flags=INODE_FLAG_INTERNAL | INODE_FLAG_READONLY)
        self.inodes.append(self.fpt_ino)
        num += 1
        self.cr_ino = None
        if has_collision:
            self.cr_ino = self.make_inode(INODE_MODE_FILE, 1, number=num,
                                          flags=INODE_FLAG_INTERNAL | INODE_FLAG_READONLY)
            self.inodes.append(self.cr_ino)
            num += 1
        uroot_ino = self.make_inode(INODE_MODE_DIR, 1, BLOCK_SIZE, BLOCK_SIZE, 3, num,
                                    INODE_FLAG_READONLY)
        self.super_root_dirents = [Dirent("flat_path_table", self.fpt_ino.number, DIRENT_FILE)]
        if has_collision:
            self.super_root_dirents.append(
                Dirent("collision_resolver", self.cr_ino.number, DIRENT_FILE))
        self.super_root_dirents.append(Dirent("uroot", uroot_ino.number, DIRENT_DIR))
        self.root.name = "uroot"
        self.root.ino = uroot_ino
        self.root.dirents = [Dirent(".", uroot_ino.number, DIRENT_DOT),
                             Dirent("..", uroot_ino.number, DIRENT_DOTDOT)]
        if self.sign:  # the outer image lacks the read-only flags
            for ino in (self.super_root_ino, self.fpt_ino, uroot_ino):
                ino.flags &= ~INODE_FLAG_READONLY

    def add_dir_inodes(self):
        self.inodes.append(self.root.ino)
        for d in sorted(self.all_dirs, key=lambda d: collation_key(d.full_path())):
            ino = self.make_inode(INODE_MODE_DIR, 1, BLOCK_SIZE, number=len(self.inodes),
                                  flags=INODE_FLAG_READONLY, nlink=2)
            d.ino = ino
            d.dirents = [Dirent(".", ino.number, DIRENT_DOT),
                         Dirent("..", d.parent.ino.number, DIRENT_DOTDOT)]
            d.parent.dirents.append(Dirent(d.name, len(self.inodes), DIRENT_DIR))
            d.parent.ino.nlink += 1
            self.inodes.append(ino)

    def add_file_inodes(self):
        for f in sorted(self.all_files, key=lambda f: collation_key(f.full_path())):
            ino = self.make_inode(INODE_MODE_FILE, ceil_div(f.size, BLOCK_SIZE), f.size,
                                  f.compressed_size, number=len(self.inodes),
                                  flags=INODE_FLAG_READONLY
                                  | (INODE_FLAG_COMPRESSED if f.compress else 0))
            if self.sign:
                ino.flags &= ~INODE_FLAG_READONLY
            f.ino = ino
            f.parent.dirents.append(Dirent(f.name, len(self.inodes), DIRENT_FILE))
            self.inodes.append(ino)

    def make_flat_path_table(self):
        table = {}
        groups = {}
        for n in self.all_nodes:
            h = path_hash(n.full_path())
            if h in table:
                table[h] = 0x80000000
                groups[h].append(n)
            else:
                table[h] = n.ino.number | (0x20000000 if isinstance(n, FSDir) else 0)
                groups[h] = [n]
        self.collisions = None
        if 0x80000000 in table.values():
            self.collisions = []
            offset = 0
            for h in sorted(table):
                if table[h] != 0x80000000:
                    continue
                table[h] = 0x80000000 | offset
                ents = [Dirent(n.full_path(), n.ino.number,
                               DIRENT_DIR if isinstance(n, FSDir) else DIRENT_FILE)
                        for n in groups[h]]
                self.collisions.append(ents)
                offset += sum(e.ent_size for e in ents) + 0x18
        self.fpt = b"".join(struct.pack("<II", h, table[h]) for h in sorted(table))
        self.cr = None
        if self.collisions is not None:
            cr = bytearray()
            for ents in self.collisions:
                cr += b"".join(e.to_bytes() for e in ents) + bytes(0x18)
            self.cr = bytes(cr)

    def ino_offset(self, number, db=0):
        '''Offset of the db[] signature of a signed inode.'''
        return BLOCK_SIZE + DINODE_S32_SIZE * number + 0x64 + SIG_SIZE * db

    @staticmethod
    def indirect_blocks(size):
        sigs_per_block = BLOCK_SIZE // SIG_SIZE
        blocks = ceil_div(size, BLOCK_SIZE)
        ib = 0
        if blocks > 12:
            blocks -= 12
            ib += 1
        if blocks > sigs_per_block:
            blocks -= sigs_per_block
            ib += 1 + ceil_div(blocks, sigs_per_block)
        return ib

    def node_size(self, n):
        return n.size

    def calculate_data_block_layout(self):
        hdr_sig = self.inode_block_sig
        inodes_per_block = BLOCK_SIZE // self.inode_size
        self.dinode_count = len(self.inodes)
        self.dinode_block_count = ceil_div(len(self.inodes), inodes_per_block)
        hdr_sig.blocks = self.dinode_block_count
        hdr_sig.size = hdr_sig.size_compressed = self.dinode_block_count * BLOCK_SIZE
        if self.sign:
            self._layout_signed()
        else:
            self._layout_plain()
        self.ndblock = max(self.ndblock, self.min_blocks)

    def _layout_signed(self):
        hdr_sig = self.inode_block_sig
        hdr_sig.flags = 0
        if self.dinode_block_count > 12:
            raise ValueError("too many inodes in the outer PFS image")
        nd = 1
        for i in range(self.dinode_block_count):
            hdr_sig.db[i] = 1 + i
            self.final_sigs.append((1 + i, 0xB8 + SIG_SIZE * i, BLOCK_SIZE))
        nd += self.dinode_block_count
        sr = self.super_root_ino
        sr.db[0] = self.dinode_block_count + 1
        self.final_sigs.append((sr.start_block, self.ino_offset(sr.number), BLOCK_SIZE))
        nd += sr.blocks

        fpt = self.fpt_ino
        fpt.db[0] = sr.start_block + 1
        fpt.size = fpt.size_compressed = len(self.fpt)
        fpt.blocks = ceil_div(len(self.fpt), BLOCK_SIZE)
        self.final_sigs.append((fpt.start_block, self.ino_offset(fpt.number), BLOCK_SIZE))
        for i in range(1, min(fpt.blocks, 12)):
            fpt.db[i] = nd
            nd += 1
            self.final_sigs.append((fpt.start_block, self.ino_offset(fpt.number, i), BLOCK_SIZE))
        if self.cr is not None:
            raise ValueError("path hash collision in the outer PFS image")

        nd += 1                # an empty block follows the flat path table
        self.empty_block = nd  # a block of zeroes that is not encrypted
        nd += 1

        ib_start = nd
        nd += sum(self.indirect_blocks(self.node_size(n)) for n in self.all_nodes)

        spb = BLOCK_SIZE // SIG_SIZE
        for n in self.all_nodes:
            size = self.node_size(n)
            blocks = ceil_div(size, BLOCK_SIZE)
            ino = n.ino
            ino.db[0] = nd
            ino.blocks = blocks
            ino.size = align(size, BLOCK_SIZE) if isinstance(n, FSDir) else size
            if ino.size_compressed == 0:
                ino.size_compressed = ino.size
            count = min(blocks, 12)
            if count:
                self.data_sig_runs.append((nd, count, self.ino_offset(ino.number)))
                nd += count
            if blocks > 12:
                self.final_sigs.append((ib_start, self.ino_offset(ino.number, 12), BLOCK_SIZE))
                count = min(blocks - 12, spb)
                self.data_sig_runs.append((nd, count, ib_start * BLOCK_SIZE))
                nd += count
                ib_start += 1
            if blocks > 12 + spb:
                done = 12 + spb
                self.final_sigs.append((ib_start, self.ino_offset(ino.number, 13), BLOCK_SIZE))
                ib1 = ib_start
                for i in range(spb):
                    if done >= blocks:
                        break
                    ib_start += 1
                    self.final_sigs.append((ib_start, ib1 * BLOCK_SIZE + i * SIG_SIZE,
                                            BLOCK_SIZE))
                    count = min(spb, blocks - done)
                    self.data_sig_runs.append((nd, count, ib_start * BLOCK_SIZE))
                    nd += count
                    done += count
        self.ndblock = nd

    def _layout_plain(self):
        hdr_sig = self.inode_block_sig
        nd = 1
        hdr_sig.db[0] = nd
        nd += 1
        for i in range(1, self.dinode_block_count):
            if i < 12:
                hdr_sig.db[i] = -1
            nd += 1
        sr = self.super_root_ino
        sr.db[0] = nd
        nd += sr.blocks

        def place(ino, data):
            nonlocal nd
            ino.db[0] = nd
            nd += 1
            ino.size = ino.size_compressed = len(data)
            ino.blocks = ceil_div(len(data), BLOCK_SIZE)
            for i in range(1, ino.blocks):
                if i < 12:
                    ino.db[i] = nd
                nd += 1

        place(self.fpt_ino, self.fpt)
        if self.cr is None:
            nd += 1  # an empty block follows the flat path table
        else:
            place(self.cr_ino, self.cr)

        for n in self.all_nodes:
            size = self.node_size(n)
            blocks = ceil_div(size, BLOCK_SIZE)
            ino = n.ino
            ino.db[0] = nd
            ino.blocks = blocks
            ino.size = align(size, BLOCK_SIZE) if isinstance(n, FSDir) else size
            if ino.size_compressed == 0:
                ino.size_compressed = ino.size
            for i in range(1, min(blocks, 12)):
                ino.db[i] = -1
            nd += blocks
        self.ndblock = nd

    def header_bytes(self):
        out = bytearray(0x5A0)
        struct.pack_into("<qqqBBBBHHIIqqqqq", out, 0, 1, 20130315, 0, 0, 0, 1, 0,
                         self.mode, 0, BLOCK_SIZE, 0, 1, self.dinode_count, self.ndblock,
                         self.dinode_block_count, 0)
        sig = self.inode_block_sig.to_bytes_s64()
        out[0x50:0x50 + len(sig)] = sig
        if self.seed is not None:
            struct.pack_into("<i", out, 0x36C, 1)
            out[0x370:0x380] = self.seed
        else:
            struct.pack_into("<i", out, 0x368, 1)
        return bytes(out)

    def inode_table_bytes(self):
        out = bytearray(self.dinode_block_count * BLOCK_SIZE)
        pos = 0
        for ino in self.inodes:
            raw = ino.to_bytes()
            out[pos:pos + len(raw)] = raw
            pos += len(raw)
            if pos % BLOCK_SIZE > BLOCK_SIZE - self.inode_size:
                pos += BLOCK_SIZE - pos % BLOCK_SIZE
        return bytes(out)

    def segments(self):
        '''
        The image contents as a sorted list of (offset, bytes or FSFile).
        Everything not covered is zero.
        '''
        segs = [(0, self.header_bytes()),
                (BLOCK_SIZE, self.inode_table_bytes()),
                (BLOCK_SIZE * (self.dinode_block_count + 1),
                 b"".join(d.to_bytes() for d in self.super_root_dirents)),
                (self.fpt_ino.start_block * BLOCK_SIZE, self.fpt)]
        if self.cr is not None:
            segs.append((self.cr_ino.start_block * BLOCK_SIZE, self.cr))
        for n in self.all_nodes:
            if isinstance(n, FSDir):
                segs.append((n.ino.start_block * BLOCK_SIZE, n.dirent_bytes()))
            elif n.size:
                segs.append((n.ino.start_block * BLOCK_SIZE, n))
        segs.sort(key=lambda s: s[0])
        pos = 0
        for off, payload in segs:
            if off < pos:
                raise ValueError("internal error: overlapping PFS data")
            pos = off + (payload.size if isinstance(payload, FSFile) else len(payload))
        if pos > self.size:
            raise ValueError("internal error: PFS data exceeds the image size")
        return segs

    def stream(self):
        '''Yields the whole image as a sequence of byte strings.'''
        pos = 0
        for off, payload in self.segments():
            if off > pos:
                yield from zeros(off - pos)
            if isinstance(payload, FSFile):
                for chunk in payload.read_chunks():
                    yield chunk
                pos = off + payload.size
            else:
                yield payload
                pos = off + len(payload)
        if self.size > pos:
            yield from zeros(self.size - pos)


_ZERO_CHUNK = bytes(1 << 20)


def zeros(n):
    while n > 0:
        k = min(n, len(_ZERO_CHUNK))
        yield _ZERO_CHUNK[:k] if k < len(_ZERO_CHUNK) else _ZERO_CHUNK
        n -= k


class ChunkReader:
    '''Reads exact-sized pieces from an iterable of byte strings.'''

    def __init__(self, chunks):
        self.it = iter(chunks)
        self.buf = bytearray()

    def read(self, n):
        while len(self.buf) < n:
            try:
                self.buf += next(self.it)
            except StopIteration:
                break
        out = bytes(self.buf[:n])
        del self.buf[:n]
        return out


def pfsc_stream(inner):
    '''An uncompressed PFSC container around a PFS image builder.'''
    size = inner.size
    num_blocks = ceil_div(size, BLOCK_SIZE)
    extra = ((8 + num_blocks * 8 - 0xFC00) + 0xFFFF) // 0x10000
    header_size = BLOCK_SIZE + (BLOCK_SIZE * extra if extra > 0 else 0)

    def chunks():
        hdr = bytearray(header_size)
        struct.pack_into(">I", hdr, 0, 0x50465343)  # "PFSC"
        struct.pack_into("<iiiqqqq", hdr, 4, 0, 6, BLOCK_SIZE, BLOCK_SIZE, 0x400,
                         header_size, num_blocks * BLOCK_SIZE)
        struct.pack_into(f"<{num_blocks + 1}q", hdr, 0x400,
                         *range(header_size, header_size + (num_blocks + 1) * BLOCK_SIZE,
                                BLOCK_SIZE))
        yield bytes(hdr)
        yield from inner.stream()

    return chunks, header_size + size, size


