ENTRY_DIGESTS = 0x0001
ENTRY_ENTRY_KEYS = 0x0010
ENTRY_IMAGE_KEY = 0x0020
ENTRY_GENERAL_DIGESTS = 0x0080
ENTRY_METAS = 0x0100
ENTRY_ENTRY_NAMES = 0x0200
ENTRY_LICENSE_DAT = 0x0400
ENTRY_LICENSE_INFO = 0x0401
ENTRY_PSRESERVED_DAT = 0x0409
ENTRY_PARAM_SFO = 0x1000
ENTRY_PLAYGO_CHUNK_DAT = 0x1001
ENTRY_PLAYGO_CHUNK_SHA = 0x1002
ENTRY_PLAYGO_MANIFEST_XML = 0x1003


def _entry_names():
    names = {
        0x0001: ".digests", 0x0010: ".entry_keys", 0x0020: ".image_key",
        0x0080: ".general_digests", 0x0100: ".metas", 0x0200: ".entry_names",
        0x0400: "license.dat", 0x0401: "license.info", 0x0402: "nptitle.dat",
        0x0403: "npbind.dat", 0x0404: "selfinfo.dat", 0x0406: "imageinfo.dat",
        0x0407: "target-deltainfo.dat", 0x0408: "origin-deltainfo.dat",
        0x0409: "psreserved.dat", 0x1000: "param.sfo", 0x1001: "playgo-chunk.dat",
        0x1002: "playgo-chunk.sha", 0x1003: "playgo-manifest.xml",
        0x1004: "pronunciation.xml", 0x1005: "pronunciation.sig", 0x1006: "pic1.png",
        0x1007: "pubtoolinfo.dat", 0x1008: "app/playgo-chunk.dat",
        0x1009: "app/playgo-chunk.sha", 0x100A: "app/playgo-manifest.xml",
        0x100B: "shareparam.json", 0x100C: "shareoverlayimage.png",
        0x100D: "save_data.png", 0x100E: "shareprivacyguardimage.png",
        0x1200: "icon0.png", 0x1220: "pic0.png", 0x1240: "snd0.at9",
        0x1260: "changeinfo/changeinfo.xml", 0x1280: "icon0.dds", 0x12A0: "pic0.dds",
        0x12C0: "pic1.dds",
    }
    for i in range(31):
        names[0x1201 + i] = f"icon0_{i:02d}.png"
        names[0x1281 + i] = f"icon0_{i:02d}.dds"
        names[0x1241 + i] = f"pic1_{i:02d}.png"
        names[0x12C1 + i] = f"pic1_{i:02d}.dds"
        names[0x1261 + i] = f"changeinfo/changeinfo_{i:02d}.xml"
        if i < 10:
            names[0x1600 + i] = f"keymap_rp/{i + 1:03d}.png"
        for j in range(10):
            names[0x1610 + 16 * i + j] = f"keymap_rp/{i:02d}/{j + 1:03d}.png"
    for i in range(100):
        names[0x1400 + i] = f"trophy/trophy{i:02d}.trp"
    return names


ENTRY_ID_TO_NAME = _entry_names()
ENTRY_NAME_TO_ID = {v: k for k, v in ENTRY_ID_TO_NAME.items()}

CONTENT_TYPE_GD = 0x1A
CONTENT_TYPE_AC = 0x1B
CONTENT_TYPE_AL = 0x1C

CONTENT_FLAG_GD_AC = 0x02000000
CONTENT_FLAG_UNK_X8000000 = 0x08000000

DRM_TYPE_PS4 = 0xF

PLAYGO_MANIFEST = (
    "﻿<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>\r\n"
    "<psproject fmt=\"playgo-manifest\" version=\"0990\">\r\n"
    "  <volume>\r\n"
    "    <chunk_info chunk_count=\"1\" scenario_count=\"1\">\r\n"
    "      <scenarios default_id=\"0\">\r\n"
    "        <scenario id=\"0\" type=\"sp\" initial_chunk_count=\"1\" "
    "label=\"Scenario #0\">0</scenario>\r\n"
    "      </scenarios>\r\n"
    "    </chunk_info>\r\n"
    "  </volume>\r\n"
    "</psproject>\r\n").encode("utf-8")


def entry_keys_data(content_id, passcode):
    seed_digest = sha256(content_id.encode("ascii").ljust(48, b"\0"))
    digests, keys = [], []
    for i in range(7):
        key = compute_key(content_id, passcode, i)
        digests.append(bytes(a ^ b for a, b in zip(sha256(key), key)))
        keys.append(rsa2048_encrypt_key(PKG_PUBLIC_KEYS[i], key))
    keys[0] = rsa2048_encrypt_key(PKG_PUBLIC_KEYS[0], passcode.encode("ascii", "replace"))
    return seed_digest + b"".join(digests) + b"".join(keys)


def license_dat_data(content_id, content_type, entitlement_key):
    secret_iv_src = sha256(content_id.encode("ascii").ljust(48, b"\0"))
    secret_iv = secret_iv_src[:16]
    secret = bytearray(144)
    secret[0:16] = secret_iv_src[16:32]
    if entitlement_key is not None and len(entitlement_key) == 16:
        secret[0x70:0x80] = entitlement_key
    secret = aes128_cbc_encrypt(RIF_DEBUG_KEY, secret_iv, bytes(secret))
    sku_flag = 3 if content_type == CONTENT_TYPE_GD else 0
    out = bytearray(0x400)
    struct.pack_into(">IhhQqq", out, 0, 0x52494600, 1, -1, 0, 1364222275, 0x7FFFFFFFFFFFFFFF)
    out[0x20:0x20 + 36] = content_id.encode("ascii")
    struct.pack_into(">hhhhiiiii", out, 0x50, 0x200, DRM_TYPE_PS4, content_type, sku_flag,
                     0, 0, 0, 1, 0)
    out[0x240:0x260] = bytes(32)  # disc key
    out[0x260:0x270] = secret_iv
    out[0x270:0x300] = secret
    out[0x300:0x400] = rsa2048_sign_sha256(sha256(bytes(out[:0x300])), DEBUG_RIF_MODULUS,
                                           DEBUG_RIF_PRIVATE_EXPONENT)
    return bytes(out)


def license_info_data(content_id, content_type, entitlement_key):
    out = bytearray(0x200)
    out[0:36] = content_id.encode("ascii")
    out[48:64] = entitlement_key if entitlement_key is not None else bytes(16)
    struct.pack_into(">iiii", out, 64, 1 if content_type == CONTENT_TYPE_AL else 0,
                     content_type, 0, 1)
    return bytes(out)


def playgo_chunk_dat(content_id, package_size, inner_pfs_size):
    out = bytearray(416)
    struct.pack_into("<IHHHHHHIHHIHH", out, 0, 0x6F676C70, 0, 0, 1, 1, 1, 1, 416, 0, 1, 0,
                     0, 0)
    out[0x20:0x40] = b"\xff" * 32
    out[0x40:0x40 + 36] = content_id.encode("ascii")
    struct.pack_into("<16I", out, 0xC0, 256, 32, 288, 2, 304, 9, 320, 16, 352, 32, 384, 2,
                     400, 12, 336, 16)
    struct.pack_into("<BBB", out, 0x100, 0x80, 0, 3)                 # chunk attrs
    struct.pack_into("<HQII", out, 0x10E, 1, 0xFFFFFFFFFFFFFFFF, 0, 0)
    struct.pack_into("<H", out, 0x120, 0)                            # chunk mchunks
    out[0x130:0x138] = b"Chunk #0"                                   # chunk labels
    struct.pack_into("<QQ", out, 0x140, 0, package_size)             # mchunk attrs
    struct.pack_into("<QQ", out, 0x150, 0, inner_pfs_size)           # inner mchunk attrs
    struct.pack_into("<B", out, 0x160, 1)                            # scenario attrs
    struct.pack_into("<HHII", out, 0x174, 1, 1, 0, 0)
    struct.pack_into("<H", out, 0x180, 0)                            # scenario chunks
    out[0x190:0x19B] = b"Scenario #0"                                # scenario labels
    return bytes(out)


class Entry:
    def __init__(self, id, name=None, data=b"", length=None, file=None):
        self.id = id
        self.name = name
        self.data = data
        self.file = file
        self._length = length

    @property
    def length(self):
        if self._length is not None:
            return self._length
        return len(self.data)


class Meta:
    def __init__(self, id, name_offset, flags1, flags2, data_offset, data_size):
        self.id = id
        self.name_offset = name_offset
        self.flags1 = flags1
        self.flags2 = flags2
        self.data_offset = data_offset
        self.data_size = data_size

    def to_bytes(self):
        return struct.pack(">6I8x", self.id, self.name_offset, self.flags1, self.flags2,
                           self.data_offset, self.data_size)

    @property
    def encrypted(self):
        return bool(self.flags1 & 0x80000000)

    @property
    def key_index(self):
        return (self.flags2 & 0xF000) >> 12


ENTRY_FLAGS1 = {
    ENTRY_DIGESTS: 0x40000000,
    ENTRY_ENTRY_KEYS: 0x60000000,
    ENTRY_IMAGE_KEY: 0xE0000000,
    ENTRY_GENERAL_DIGESTS: 0x60000000,
    ENTRY_METAS: 0x60000000,
    ENTRY_ENTRY_NAMES: 0x40000000,
    ENTRY_LICENSE_DAT: 0x80000000,
    ENTRY_LICENSE_INFO: 0x80000000,
}

ENTRY_FLAGS2 = {
    ENTRY_IMAGE_KEY: 3 << 12,
    ENTRY_LICENSE_DAT: 3 << 12,
    ENTRY_LICENSE_INFO: 2 << 12,
}

GENERAL_DIGEST_CONTENT = 1 << 1
GENERAL_DIGEST_GAME = 1 << 2
GENERAL_DIGEST_HEADER = 1 << 3
GENERAL_DIGEST_SYSTEM = 1 << 4
GENERAL_DIGEST_MAJOR_PARAM = 1 << 5
GENERAL_DIGEST_PARAM = 1 << 6


class PkgHeader:
    def __init__(self):
        self.flags = 1
        self.entry_count = 6
        self.sc_entry_count = 6
        self.entry_count_2 = 6
        self.entry_table_offset = 0x2A80
        self.main_ent_data_size = 0xD00
        self.body_offset = 0x2000
        self.body_size = 0x7E000
        self.content_id = ""
        self.drm_type = DRM_TYPE_PS4
        self.content_type = 0
        self.content_flags = 0
        self.promote_size = 0
        self.version_date = 0x20161020
        self.version_hash = 0x1738551
        self.iro_tag = 0
        self.ekc_version = 1
        self.sc_entries1_hash = bytes(32)
        self.sc_entries2_hash = bytes(32)
        self.digest_table_hash = bytes(32)
        self.body_digest = bytes(32)
        self.unk_0x400 = 1
        self.pfs_image_count = 0
        self.pfs_flags = 0
        self.pfs_image_offset = 0
        self.pfs_image_size = 0
        self.mount_image_offset = 0
        self.mount_image_size = 0
        self.package_size = 0
        self.pfs_signed_size = 0
        self.pfs_cache_size = 0
        self.pfs_image_digest = bytes(32)
        self.pfs_signed_digest = bytes(32)
        self.pfs_split_size_nth_0 = 0
        self.pfs_split_size_nth_1 = 0

    def to_bytes(self):
        out = bytearray(0x490)
        struct.pack_into(">4sIIIIHHIIQQ", out, 0, b"\x7fCNT", self.flags, 0, 0xF,
                         self.entry_count, self.sc_entry_count, self.entry_count_2,
                         self.entry_table_offset, self.main_ent_data_size, self.body_offset,
                         self.body_size)
        out[0x40:0x40 + len(self.content_id)] = self.content_id.encode("ascii")
        struct.pack_into(">IIIIIIIIIIII", out, 0x70, self.drm_type, self.content_type,
                         self.content_flags, self.promote_size, self.version_date,
                         self.version_hash, 0, 0, 0, 0, self.iro_tag, self.ekc_version)
        out[0x100:0x120] = self.sc_entries1_hash
        out[0x120:0x140] = self.sc_entries2_hash
        out[0x140:0x160] = self.digest_table_hash
        out[0x160:0x180] = self.body_digest
        struct.pack_into(">IIQQQQQQII", out, 0x400, self.unk_0x400, self.pfs_image_count,
                         self.pfs_flags, self.pfs_image_offset, self.pfs_image_size,
                         self.mount_image_offset, self.mount_image_size, self.package_size,
                         self.pfs_signed_size, self.pfs_cache_size)
        out[0x440:0x460] = self.pfs_image_digest
        out[0x460:0x480] = self.pfs_signed_digest
        struct.pack_into(">QQ", out, 0x480, self.pfs_split_size_nth_0,
                         self.pfs_split_size_nth_1)
        return bytes(out)


###############################################################################
# PKG builder
###############################################################################

def log_nothing(msg):
    pass


class PkgBuilder:
    def __init__(self, proj, log=log_nothing):
        self.proj = proj
        self.log = log
        self.content_id = proj.content_id
        self.passcode = proj.passcode
        self.volume_type = proj.volume_type
        self.content_type = {"pkg_ps4_app": CONTENT_TYPE_GD,
                             "pkg_ps4_ac_data": CONTENT_TYPE_AC,
                             "pkg_ps4_ac_nodata": CONTENT_TYPE_AL}[proj.volume_type]
        self.entitlement_key = None
        if proj.entitlement_key is not None:
            self.entitlement_key = from_hex_compact(proj.entitlement_key)
        self.ekpfs = compute_key(self.content_id, self.passcode, 1)
        self.file_time = proj.timestamp()
        self.root = self.build_tree()

    def build_tree(self):
        root = FSDir("")

        def get_or_add(parent, name):
            d = parent.get_dir(name)
            if d is None:
                d = FSDir(name, parent)
                parent.dirs.append(d)
            return d

        def add_dirs(parent, dirs):
            for name, children in dirs:
                d = parent
                for part in name.split("/"):
                    if part:
                        d = get_or_add(d, part)
                add_dirs(d, children)

        add_dirs(root, self.proj.dirs)
        for targ, orig in self.proj.files:
            parts = targ.split("/")
            parent = root
            for part in parts[:-1]:
                parent = get_or_add(parent, part)
            parent.files.append(FSFile(parts[-1], parent, path=self.proj.source_path(orig)))
        return root

    def creation_info(self):
        c_date = self.proj.c_date
        now = datetime.now(timezone.utc)
        if not c_date:
            when, use_time = now, False
        elif c_date == "actual_datetime":
            when, use_time = now, True
        else:
            use_time = len(c_date.split(" ")) == 2
            when = parse_datetime(c_date)
            if use_time:
                when = when.astimezone(timezone.utc)
        info = "c_date=" + when.strftime("%Y%m%d")
        if use_time:
            info += ",c_time=" + when.strftime("%H%M%S")
        return info

    def build(self, output):
        log = self.log
        has_pfs = self.content_type != CONTENT_TYPE_AL
        self.inner = self.outer = None
        pfs_size = 0
        if has_pfs:
            if self.content_type == CONTENT_TYPE_GD and \
               self.root.get_file("sce_sys/keystone") is None:
                sce_sys = self.root.get_dir("sce_sys")
                sce_sys.files.append(FSFile("keystone", sce_sys,
                                            data=create_keystone(self.passcode)))
            log("Preparing inner PFS...")
            self.inner = PfsBuilder(self.root, self.file_time,
                                    min_blocks=0x55 if self.content_type == CONTENT_TYPE_GD
                                    else 0)
            log("Preparing outer PFS...")
            chunks, size, csize = pfsc_stream(self.inner)
            outer_root = FSDir("")
            outer_root.files.append(FSFile("pfs_image.dat", outer_root, chunks=chunks,
                                           size=size, compressed_size=csize, compress=True))
            self.outer = PfsBuilder(outer_root, self.file_time, sign=True, encrypt=True,
                                    ekpfs=self.ekpfs, seed=bytes(16))
            pfs_size = self.outer.size
        log("Preparing PKG header and body...")
        self.layout_pkg(pfs_size)

        hdr = self.header
        total = hdr.body_offset + hdr.body_size + hdr.pfs_image_size
        with open(output, "w+b") as f:
            f.truncate(total)
            if has_pfs:
                self.write_outer_pfs(f, hdr.pfs_image_offset)
                log("Calculating SHA256 of finished outer PFS...")
                hdr.pfs_signed_digest, hdr.pfs_image_digest = file_digests(
                    f, hdr.pfs_image_offset, hdr.pfs_image_size, 0x10000)
            self.finish_pkg(f)

    def layout_pkg(self, pfs_size):
        hdr = self.header = PkgHeader()
        hdr.content_id = self.content_id
        hdr.content_type = self.content_type
        hdr.content_flags = CONTENT_FLAG_UNK_X8000000 | (
            CONTENT_FLAG_GD_AC if self.content_type != CONTENT_TYPE_AL else 0)
        if self.content_type != CONTENT_TYPE_AL:
            hdr.pfs_image_count = 1
            hdr.pfs_flags = 0x80000000000003CC
            hdr.pfs_image_offset = 0x80000
            hdr.pfs_image_size = pfs_size
            hdr.package_size = 0x80000 + pfs_size
            hdr.pfs_signed_size = 0x10000
            hdr.pfs_cache_size = 0xD0000

        sfo_file = self.root.get_file("sce_sys/param.sfo")
        if sfo_file is None:
            raise ValueError("Missing param.sfo!")
        sfo = self.sfo = ParamSfo.parse(sfo_file.read_all())
        info = self.creation_info()
        if self.content_type != CONTENT_TYPE_AL:
            info += (f",img0_l0_size={(hdr.package_size + 0xFFFFF) // (1024 * 1024)}"
                     ",img0_l1_size=0,img0_sc_ksize=512,img0_pc_ksize=832")
        sfo["PUBTOOLINFO"] = SfoValue("PUBTOOLINFO", SFO_UTF8, info, 0x200)
        sfo["PUBTOOLVER"] = SfoValue("PUBTOOLVER", SFO_INTEGER, 0x02890000)
        self.sfo_bytes = sfo.serialize()

        ent = self.entries = {}
        entries = [
            Entry(ENTRY_ENTRY_KEYS, data=entry_keys_data(self.content_id, self.passcode)),
            Entry(ENTRY_IMAGE_KEY, data=rsa2048_encrypt_key(FAKE_KEYSET_MODULUS, self.ekpfs)),
            Entry(ENTRY_GENERAL_DIGESTS, length=0x180),
            Entry(ENTRY_METAS),
            Entry(ENTRY_DIGESTS),
            Entry(ENTRY_ENTRY_NAMES),
        ]
        if self.content_type == CONTENT_TYPE_GD:
            entries += [
                Entry(ENTRY_PLAYGO_CHUNK_DAT, "playgo-chunk.dat", length=416),
                Entry(ENTRY_PLAYGO_CHUNK_SHA, "playgo-chunk.sha"),
                Entry(ENTRY_PLAYGO_MANIFEST_XML, "playgo-manifest.xml", PLAYGO_MANIFEST),
            ]
        entries += [
            Entry(ENTRY_LICENSE_DAT, data=license_dat_data(self.content_id, self.content_type,
                                                           self.entitlement_key)),
            Entry(ENTRY_LICENSE_INFO, data=license_info_data(self.content_id,
                                                             self.content_type,
                                                             self.entitlement_key)),
            Entry(ENTRY_PARAM_SFO, "param.sfo", self.sfo_bytes),
            Entry(ENTRY_PSRESERVED_DAT, data=bytes(0x2000)),
        ]
        sce_sys = self.root.get_dir("sce_sys")
        for f in sce_sys.all_files():
            name = f.name
            parent = f.parent
            while parent is not None and parent is not self.root and parent.name != "sce_sys":
                name = parent.name + "/" + name
                parent = parent.parent
            if name not in ENTRY_NAME_TO_ID or name == "param.sfo":
                continue
            eid = ENTRY_NAME_TO_ID[name]
            entries.append(Entry(eid, ENTRY_ID_TO_NAME[eid], file=f, length=f.size))
        for e in entries:
            ent[e.id] = e
        self.entry_list = entries
        ent[ENTRY_DIGESTS].data = bytes(32 * len(entries))

        # Name table, in sorted order
        names = [""]
        name_offsets = {"": 0}
        length = 1
        for e in sorted(entries, key=lambda e: collation_key(e.name)):
            if e.name and e.name not in name_offsets:
                names.append(e.name)
                name_offsets[e.name] = length
                length += len(e.name) + 1
        ent[ENTRY_ENTRY_NAMES].data = b"".join(n.encode("ascii") + b"\0" for n in names)

        # Entry table
        metas = []
        data_offset = hdr.body_offset
        for e in entries:
            m = Meta(e.id, name_offsets[e.name] if e.name else 0, ENTRY_FLAGS1.get(e.id, 0),
                     ENTRY_FLAGS2.get(e.id, 0), data_offset, 0)
            metas.append(m)
            if e.id == ENTRY_METAS:
                m.data_size = len(entries) * 32
            elif e.id == ENTRY_PLAYGO_CHUNK_SHA:
                # Estimate the PKG size, as LibOrbisPkg does
                def cur_len(x):
                    if x.id == ENTRY_METAS:
                        return len(metas) * 32
                    if x.id == ENTRY_PLAYGO_CHUNK_SHA:
                        return 0
                    return x.length
                pkg_size = align(hdr.body_offset + sum(align(cur_len(x), 16) for x in entries),
                                 0x80000) + pfs_size
                pkg_size += ((pkg_size + 16) // 0x10000) * 4
                m.data_size = (pkg_size // 0x10000) * 4
            else:
                m.data_size = e.length
            data_offset = align(data_offset + m.data_size, 16)
            e.meta = m
        body_size = data_offset - hdr.body_offset
        metas.sort(key=lambda m: m.id)
        self.metas = metas
        hdr.entry_count = len(entries)
        hdr.entry_count_2 = len(entries)
        hdr.body_size = align(hdr.body_offset + body_size, 0x80000) - hdr.body_offset
        hdr.main_ent_data_size = (ent[ENTRY_ENTRY_KEYS].length + ent[ENTRY_IMAGE_KEY].length
                                  + 0x180 + len(entries) * 32 + len(entries) * 32)
        if self.content_type != CONTENT_TYPE_AL:
            hdr.pfs_image_offset = hdr.body_offset + hdr.body_size
            hdr.package_size = hdr.mount_image_size = (hdr.body_size + hdr.body_offset
                                                       + hdr.pfs_image_size)
        if self.content_type == CONTENT_TYPE_GD:
            sha = ent[ENTRY_PLAYGO_CHUNK_SHA]
            sha.data = bytearray(4 * (hdr.package_size // PLAYGO_CHUNK_SIZE))
            if len(sha.data) > sha.meta.data_size:
                raise ValueError("internal error: playgo-chunk.sha was not allocated "
                                 "enough space")
            sha.meta.data_size = len(sha.data)
            ent[ENTRY_PLAYGO_CHUNK_DAT].data = playgo_chunk_dat(
                self.content_id, hdr.package_size, self.inner.size)
            hdr.promote_size = hdr.body_size + hdr.body_offset

    def write_outer_pfs(self, f, pfs_offset):
        '''Writes, signs and encrypts the outer PFS image, and hashes PlayGo chunks.'''
        log = self.log
        outer = self.outer
        sign_key = pfs_crypto_key(self.ekpfs, outer.seed, 2)
        enc_key = pfs_crypto_key(self.ekpfs, outer.seed, 1)
        xts = XtsEncryptor(enc_key[16:32], enc_key[0:16])
        chunk_sha = self.entries.get(ENTRY_PLAYGO_CHUNK_SHA)
        chunk_base = pfs_offset // PLAYGO_CHUNK_SIZE

        image_file = outer.root.files[0]
        data_start = image_file.ino.start_block
        reader = ChunkReader(outer.stream())
        meta = bytearray(reader.read(data_start * BLOCK_SIZE))

        def put_sig(buf, offset, block, data):
            buf[offset:offset + 32] = hmac_sha256(sign_key, data)
            struct.pack_into("<i", buf, offset + 32, block)

        def encrypt_block(block, data):
            if block == 0 or block == outer.empty_block:
                return bytes(data)
            sector = block * (BLOCK_SIZE // XTS_SECTOR_SIZE)
            return b"".join(xts.encrypt_sector(data[i:i + XTS_SECTOR_SIZE], sector + k)
                            for k, i in enumerate(range(0, BLOCK_SIZE, XTS_SECTOR_SIZE)))

        def hash_chunk(block, data):
            if chunk_sha is not None:
                i = chunk_base + block
                chunk_sha.data[4 * i:4 * i + 4] = sha256(data)[:4]

        log("Writing, signing and encrypting the outer PFS...")
        total_blocks = outer.ndblock
        f.seek(pfs_offset + data_start * BLOCK_SIZE)
        for first, count, sig_off in outer.data_sig_runs:
            for k in range(count):
                block = first + k
                if block < data_start:
                    data = bytes(meta[block * BLOCK_SIZE:(block + 1) * BLOCK_SIZE])
                    put_sig(meta, sig_off + SIG_SIZE * k, block, data)
                    continue
                if f.tell() != pfs_offset + block * BLOCK_SIZE:
                    raise ValueError("internal error: unexpected PFS data block order")
                data = reader.read(BLOCK_SIZE)
                if len(data) != BLOCK_SIZE:
                    raise ValueError("internal error: short PFS image")
                put_sig(meta, sig_off + SIG_SIZE * k, block, data)
                data = encrypt_block(block, data)
                hash_chunk(block, data)
                f.write(data)
        if reader.read(1):
            raise ValueError("internal error: PFS image is larger than its layout")
        if f.tell() != pfs_offset + total_blocks * BLOCK_SIZE:
            raise ValueError("internal error: PFS image is smaller than its layout")

        for block, sig_off, size in reversed(outer.final_sigs):
            data = bytes(meta[block * BLOCK_SIZE:block * BLOCK_SIZE + size])
            put_sig(meta, sig_off, block, data)

        f.seek(pfs_offset)
        for block in range(data_start):
            data = encrypt_block(block, meta[block * BLOCK_SIZE:(block + 1) * BLOCK_SIZE])
            hash_chunk(block, data)
            f.write(data)

    def general_digests(self):
        hdr = self.header
        sfo = self.sfo

        def s(name):
            v = sfo[name]
            return "" if v is None else str(v)

        major = "ATTRIBUTE" + s("ATTRIBUTE")
        if sfo["ATTRIBUTE2"] is not None:
            major += "ATTRIBUTE2" + s("ATTRIBUTE2")
        major += "CATEGORY" + s("CATEGORY") + "FORMAT" + s("FORMAT") + \
            "PUBTOOLVER" + s("PUBTOOLVER")
        major_digest = sha256(major.encode("ascii", "replace"))

        content = bytearray(self.content_id.encode("ascii")[:36].ljust(48, b"\0"))
        content += struct.pack(">ii", hdr.drm_type, hdr.content_type)
        if hdr.content_type in (CONTENT_TYPE_AC, CONTENT_TYPE_GD) or \
           hdr.content_flags & CONTENT_FLAG_GD_AC:
            content += hdr.pfs_image_digest
        content += major_digest

        raw = hdr.to_bytes()
        digests = {
            GENERAL_DIGEST_HEADER: sha256(raw[0:64], raw[0x400:0x480]),
            GENERAL_DIGEST_CONTENT: sha256(bytes(content)),
            GENERAL_DIGEST_MAJOR_PARAM: major_digest,
            GENERAL_DIGEST_PARAM: sha256(self.sfo_bytes),
        }
        if hdr.content_type != CONTENT_TYPE_AL:
            digests[GENERAL_DIGEST_GAME] = hdr.pfs_image_digest

        out = bytearray(0x180)
        struct.pack_into(">HH", out, 0, 0xD256, 0x100)
        struct.pack_into(">i", out, 28, sum(digests))
        for i, flag in enumerate((GENERAL_DIGEST_CONTENT, GENERAL_DIGEST_GAME,
                                  GENERAL_DIGEST_HEADER, GENERAL_DIGEST_SYSTEM,
                                  GENERAL_DIGEST_MAJOR_PARAM, GENERAL_DIGEST_PARAM)):
            out[32 + 32 * i:64 + 32 * i] = digests.get(flag, bytes(32))
        return bytes(out)

    def finish_pkg(self, f):
        hdr = self.header
        ent = self.entries
        ent[ENTRY_GENERAL_DIGESTS].data = self.general_digests()
        ent[ENTRY_METAS].data = b"".join(m.to_bytes() for m in self.metas)

        # Body
        body = bytearray(hdr.body_offset + hdr.body_size)
        for e in self.entry_list:
            m = e.meta
            data = e.file.read_all() if e.file is not None else bytes(e.data)
            if len(data) != m.data_size:
                raise ValueError(f"internal error: entry {e.id:#x} has the wrong size")
            if m.encrypted:
                iv_key = sha256(m.to_bytes(),
                                compute_key(self.content_id, self.passcode, m.key_index))
                data = aes128_cbc_encrypt(iv_key[16:32], iv_key[0:16], data)
            body[m.data_offset:m.data_offset + len(data)] = data

        digests_meta = ent[ENTRY_DIGESTS].meta
        for i, m in enumerate(self.metas):
            if i == 0:
                continue
            h = sha256(bytes(body[m.data_offset:m.data_offset + m.data_size]))
            pos = digests_meta.data_offset + 32 * i
            body[pos:pos + 32] = h
        hdr.body_digest = sha256(bytes(body[hdr.body_offset:]))
        dm = digests_meta
        hdr.digest_table_hash = sha256(bytes(body[dm.data_offset:dm.data_offset + dm.data_size]))

        def entry_bytes(eid, size=None):
            m = ent[eid].meta
            return bytes(body[m.data_offset:m.data_offset + (m.data_size if size is None
                                                              else size)])
        sc = [ENTRY_ENTRY_KEYS, ENTRY_IMAGE_KEY, ENTRY_GENERAL_DIGESTS, ENTRY_METAS]
        sc1 = b"".join(entry_bytes(e) for e in sc + [ENTRY_DIGESTS])
        if len(sc1) != hdr.main_ent_data_size:
            raise ValueError("internal error: main_ent_data_size mismatch")
        hdr.sc_entries1_hash = sha256(sc1)
        hdr.sc_entries2_hash = sha256(b"".join(
            entry_bytes(e, hdr.sc_entry_count * 0x20 if e == ENTRY_METAS else None)
            for e in sc))

        raw = hdr.to_bytes()
        body[0:len(raw)] = raw
        body[0xFE0:0x1000] = sha256(bytes(body[0:0xFE0]))
        body[0x1000:0x1100] = rsa2048_encrypt_key(PKG_PUBLIC_KEYS[3], sha256(bytes(body[0:0x1000])))
        f.seek(0)
        f.write(body)


def file_digests(f, offset, size, head_size):
    '''SHA-256 of the first `head_size` bytes and of all `size` bytes at `offset`.'''
    f.flush()
    f.seek(offset)
    whole = hashlib.sha256()
    head = None
    remaining = size
    while remaining > 0:
        buf = f.read(min(1 << 22, remaining))
        if not buf:
            raise IOError("unexpected end of the output file")
        if head is None:
            head = sha256(buf[:head_size])
        whole.update(buf)
        remaining -= len(buf)
    return head, whole.digest()


def from_hex_compact(text):
    '''Hex string to bytes, skipping non-hex characters like LibOrbisPkg.'''
    out = bytearray()
    key = text.replace(" ", "")
    x = 0
    while x < len(key) - 1:
        result = 0
        for _ in range(2):
            result = (result << 4) & 0xFF
            c = key[x]
            x += 1
            if "0" <= c <= "9":
                result |= ord(c) - ord("0")
            elif "a" <= c <= "f":
                result |= ord(c) - ord("a") + 10
            elif "A" <= c <= "F":
                result |= ord(c) - ord("A") + 10
        out.append(result)
    return bytes(out)


###############################################################################
# Command line
###############################################################################

def main():
    parser = argparse.ArgumentParser(description=__doc__.strip())
    parser.add_argument("-o", "--output", metavar="PATH", type=str, default=".",
                        help="write the PKG to PATH; if PATH is a directory, write "
                        "CONTENT_ID.pkg in it (default: current directory)")
    parser.add_argument("-v", "--verbose", action="store_true",
                        help="print progress messages")
    parser.add_argument("project", metavar="PROJECT", type=str,
                        help="the GP4 project file")
    args = parser.parse_args()

    def log(msg):
        if args.verbose:
            print(msg, file=sys.stderr)

    try:
        proj = Gp4Project(args.project)
    except Gp4Error as e:
        print(f"{parser.prog}: {e}", file=sys.stderr)
        return 1

    results = validate_project(proj)
    if results:
        print(f"Found {len(results)} issue(s) with GP4 project:", file=sys.stderr)
    for is_fatal, msg in results:
        print(f"{'FATAL ERROR' if is_fatal else 'WARNING    '}: {msg}", file=sys.stderr)
    if any(is_fatal for is_fatal, _ in results):
        print("Cannot build PKG due to fatal errors.", file=sys.stderr)
        return 1

    output = args.output
    if os.path.isdir(output) or output.endswith(("/", os.sep)):
        output = os.path.join(output, f"{proj.content_id}.pkg")

    if Cipher is None:
        log("Note: the python 'cryptography' package is not installed; "
            "using a slower built-in AES implementation.")

    try:
        PkgBuilder(proj, log).build(output)
    except BaseException as e:
        try:
            os.unlink(output)
        except OSError:
            pass
        if isinstance(e, (OSError, ValueError, Gp4Error)):
            print(f"{parser.prog}: {e}", file=sys.stderr)
            return 1
        raise
    log(f"Wrote {output}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
